# 环境变量示例
# 复制本文件为 .env 或按脚本要求复制到对应 env 文件后，再在本机填入真实值。
# 本文件只能包含变量名、占位符和说明，禁止写入真实 API Key、数据库密码、账号、Cookie、Token、生产连接串。
# 信息无法确认时在对应 Markdown 中标注“待确认”，不要在本文件中编造配置项。

# ===== 旧诊断 API 配置（app/main.py 用，均有默认值）=====
KNOWLEDGE_MD_PATH=data/docs/cnnc_ops_knowledge_pure.md
TEMPLATES_DIR=app/templates
LOG_LEVEL=INFO

# ===== 模型 API 配置（data/model.env，价格审计用）=====
# 实际放在 data/model.env，这里仅作示例
TITLE_MATCH_MODEL_API_KEY=<your_model_api_key>
TITLE_MATCH_MODEL_BASE_URL=<your_model_base_url>
TITLE_MATCH_MODEL_NAME=<your_model_name>

# ===== SaaS 接口认证（监控状态查询用）=====
# 从 saasportal.iio.com 浏览器 F12 抓 Cookie
SAAS_COOKIE=<your_saas_cookie>
# 或单独传 token（monitor_status_export.py 用）
X_ACCESS_TOKEN=<your_saas_access_token>

# ===== 中核接口认证（监控状态查询用）=====
# 从 cnncmall.com 浏览器 F12 抓
# 注意：URL 里的 y1AmuISe 和 header 里的 y1AmuISe 是两个不同的值！
CNNC_QUERY_Y1AMUISE=<your_cnnc_query_y1amuise>
CNNC_HEADER_Y1AMUISE=<your_cnnc_header_y1amuise>
CNNC_COOKIE=<your_cnnc_cookie>

# ===== 招商局任务系统认证（价格审计用）=====
# 从 zhaosj.iioprod.com 浏览器 F12 抓
# 当前外部招商局工具读取 BLADE_AUTH 和 COOKIE；ZHAOSHANG_COOKIE 仅作为语义化备用占位，使用前需确认调用脚本是否读取
BLADE_AUTH=<your_zhaoshang_blade_auth>
COOKIE=<your_zhaoshang_cookie>
ZHAOSHANG_COOKIE=<your_zhaoshang_cookie>

# ===== 内网接口代理绕过（可选；脚本内会自动处理，手工运行时可参考）=====
# 不要把内网 SaaS / 中核 / 招商局请求发到本地 HTTP 代理
NO_PROXY=localhost,127.0.0.1,::1,0.0.0.0,saasportal.iio.com,zhaosj.iioprod.com,www.cnncmall.com,cnncmall.com,172.168.1.245,192.168.10.239,10.100.12.250

# ===== 模型批量调参（可选，价格审计用）=====
TITLE_MATCH_MODEL_BATCH_SIZE=30
TITLE_MATCH_MODEL_BATCH_CONCURRENCY=1
TITLE_MATCH_MODEL_TIMEOUT=180
TITLE_MATCH_MODEL_RETRY_SLEEP=5
# 每个单条/批量模型操作的有限重试策略；无效值均回退到默认值。
TITLE_MATCH_MODEL_MAX_ATTEMPTS=3
TITLE_MATCH_MODEL_MAX_ELAPSED_SECONDS=300
# 兼容旧配置：仅在 MAX_ATTEMPTS 未设置时生效，语义仍是最大尝试次数。
TITLE_MATCH_MODEL_MAX_RETRIES=

# ===== STEP_1 Dashboard SaaS Flow Diagnostic 只读数据库(可选;未配置时该面板降级) =====
# 真实值只能放本机 ignored 的 data/CNNC_DIAG_DB.env 或进程环境变量,禁止写入任何 Git 文件/日志/响应
CNNC_DIAG_DB_HOST=<readonly_db_host>
CNNC_DIAG_DB_PORT=3306
CNNC_DIAG_DB_USER=<readonly_db_user>
CNNC_DIAG_DB_PASSWORD=<readonly_db_password>
# 缓存与限流(可选;cache 下限 60 秒,默认 60/30)
CNNC_DIAG_CACHE_SECONDS=60
CNNC_DIAG_FRESH_MIN_INTERVAL_SECONDS=30

# ===== 监控状态查询 token（可选，monitor_status_export.py 用）=====
# 如果不用 SAAS_COOKIE，也可直接传 x-access-token
# X_ACCESS_TOKEN=<your_token>
