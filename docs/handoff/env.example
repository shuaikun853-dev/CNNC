# 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 不会被提交到 git）
# 本文件不含任何真实密钥

# ===== 旧诊断 API 配置（app/main.py 用，均有默认值）=====
KNOWLEDGE_MD_PATH=data/docs/cnnc_ops_knowledge_pure.md
TEMPLATES_DIR=app/templates
LOG_LEVEL=INFO

# ===== 模型 API 配置（data/model.env，价格审计用）=====
# 实际放在 data/model.env，这里仅作示例
TITLE_MATCH_MODEL_API_KEY=your_model_api_key_here
TITLE_MATCH_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
TITLE_MATCH_MODEL_NAME=doubao-seed-2-0-mini-260215

# ===== SaaS 接口认证（监控状态查询用）=====
# 从 saasportal.iio.com 浏览器 F12 抓 Cookie
SAAS_COOKIE=x-access-token=your_saas_access_token_here; refreshToken=your_saas_refresh_token_here
# 或单独传 token（monitor_status_export.py 用）
X_ACCESS_TOKEN=your_saas_access_token_here

# ===== 中核接口认证（监控状态查询用）=====
# 从 cnncmall.com 浏览器 F12 抓
# 注意：URL 里的 y1AmuISe 和 header 里的 y1AmuISe 是两个不同的值！
CNNC_QUERY_Y1AMUISE=your_cnnc_query_y1amuise_here
CNNC_HEADER_Y1AMUISE=your_cnnc_header_y1amuise_here
CNNC_COOKIE=auth-token=your_cnnc_auth_token_here; access-token=your_cnnc_access_token_here

# ===== 招商局任务系统认证（价格审计用）=====
# 从 zhaosj.iioprod.com 浏览器 F12 抓
BLADE_AUTH=bearer your_zhaoshang_blade_auth_token_here
ZHAOSHANG_COOKIE=your_zhaoshang_cookie_here

# ===== 模型批量调参（可选，价格审计用）=====
TITLE_MATCH_MODEL_BATCH_SIZE=30
TITLE_MATCH_MODEL_BATCH_CONCURRENCY=12
TITLE_MATCH_MODEL_TIMEOUT=180

# ===== 监控状态查询 token（可选，monitor_status_export.py 用）=====
# 如果不用 SAAS_COOKIE，也可直接传 x-access-token
# X_ACCESS_TOKEN=your_token_here
